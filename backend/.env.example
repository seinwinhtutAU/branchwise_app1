# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres connection for Alembic migrations.
# Project Settings > Database > Connection string > "Session pooler" tab (NOT
# "URI"/direct — the direct db.<ref>.supabase.co host is IPv6-only and won't
# resolve on most home networks). Copy that URI, then prepend "+psycopg" to
# the scheme so SQLAlchemy uses the psycopg (v3) driver instead of psycopg2.
# URL-encode any special characters in the password (@ # % /).
DATABASE_URL=postgresql+psycopg://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# App
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
